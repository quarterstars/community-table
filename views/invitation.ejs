<% const t = typeof locals.t === 'function' ? locals.t : value => String(value ?? ''); const lang = locals.lang || 'en'; %>
<%- include('partials/header') %>
<main id="main-content" class="page">
  <div class="page-intro"><h1><%= t("Volunteer invitation") %></h1></div>
  <p><%= t("You are invited as a volunteer for") %> <strong><%= invitation.organizationName %></strong>.</p>
  <p><%= t("Account email:") %> <strong><%= invitation.email %></strong></p>
  <% if (!currentUser) { %>
    <a class="button button-primary" href="/login?next=<%= encodeURIComponent('/invitations/' + token) %>"><%= t('Log in') %></a>
    <a class="text-action" href="/signup?next=<%= encodeURIComponent('/invitations/' + token) %>"><%= t('Create an account') %></a>
  <% } else { %>
  <form class="account-form" method="post" action="/invitations/<%= token %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="confirmation-check"><input type="checkbox" name="confirm" value="accept" required> <%= t('I accept volunteer access to this organization.') %></label>
    <button class="button button-primary" type="submit"><%= t('Accept invitation') %></button>
  </form>
  <% } %>
</main>
<%- include('partials/footer') %>
