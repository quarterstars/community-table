<% const t = typeof locals.t === 'function' ? locals.t : value => String(value ?? ''); const lang = locals.lang || 'en'; %>
<%- include('partials/header') %>
<main id="main-content" class="page">
  <a class="back-link" href="/my-pickups"><%- include('partials/icon', { name: 'left' }) %> <%= t("My Pickups") %></a>
  <div class="page-intro"><h1><%= t("Your reservation") %></h1></div>
  <%- include('partials/preview-notice') %>
  <div class="pickup-list"><%- include('partials/reservation-card', { reservation, showDetailLink: false }) %></div>
</main>
<%- include('partials/footer') %>
