<% const t = typeof locals.t === 'function' ? locals.t : value => String(value ?? ''); const lang = locals.lang || 'en'; %>
<%- include('partials/header') %>
<main id="main-content" class="page">
  <a class="back-link" href="/my-pickups"><%- include('partials/icon', { name: 'left' }) %> <%= t("My Pickups") %></a>
  <div class="page-intro"><h1><%= t(reservation.status === 'cancelled' ? 'Reservation cancelled.' : 'Your reservation') %></h1></div>
  <p class="field-help pickup-timezone"><%= t('Times shown in America/Chicago.') %></p>
  <%- include('partials/preview-notice') %>
  <div class="pickup-list"><%- include('partials/reservation-card', { reservation }) %></div>
</main>
<%- include('partials/footer') %>
