<% const t = typeof locals.t === 'function' ? locals.t : value => String(value ?? ''); const lang = locals.lang || 'en'; %>
    <% const selectedPage = locals.organization ? 'share' : activePage; const links = [['/', 'browse', 'browse', 'Browse'], ['/share-food', 'share', 'portions', 'Share Food'], ['/my-pickups', 'pickups', 'bag', 'My Pickups'], ['/profile', 'profile', 'user', 'Profile']]; %>
    </div>
    <nav class="bottom-nav organizer-nav" aria-label="<%= t('Main navigation') %>">
      <% for (const [href, key, icon, label] of links) { %>
        <a href="<%= href %>" class="nav-link <%= selectedPage === key ? 'is-active' : '' %>" <% if (selectedPage === key) { %>aria-current="page"<% } %>>
          <span class="nav-icon"><%- include('icon', { name: icon }) %></span><span><%= t(label) %></span>
        </a>
      <% } %>
    </nav>
  </div>
</body>
</html>
