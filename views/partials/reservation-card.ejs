<% const t = typeof locals.t === 'function' ? locals.t : value => String(value ?? ''); const lang = locals.lang || 'en'; %>
<article class="pickup-card">
  <div class="food-title-row"><h2><%= reservation.food.name %></h2><span class="sample-label"><%= t(reservation.statusLabel) %></span></div>
  <p class="organization"><%= reservation.food.organization %></p>
  <p class="pickup-fact"><strong><%= t("Quantity:") %></strong> <%= reservation.quantity %> <%= t(reservation.quantity === 1 ? 'portion' : 'portions') %></p>
  <p class="pickup-fact"><strong><%= t(reservation.status === 'cancelled' ? 'Original pickup:' : 'Pickup:') %></strong> <time datetime="<%= reservation.pickupDateISO %>"><%= reservation.pickupDate %></time><span class="pickup-window"><%= reservation.pickupWindow %></span></p>
  <% if (reservation.status === 'cancelled') { %>
    <p class="pickup-fact"><strong><%= t('Original location:') %></strong> <%= reservation.food.pickupLocation %></p>
    <% if (reservation.cancelledAt) { %><p class="pickup-fact"><strong><%= t('Cancelled on:') %></strong> <time datetime="<%= new Date(reservation.cancelledAt).toISOString() %>"><%= formattedDate(reservation.cancelledAt) %></time></p><% } %>
    <p class="reservation-note"><%= t('Your reservation was cancelled and its portions were returned to the listing. This reservation can no longer be collected.') %></p>
  <% } else { %>
  <p class="pickup-fact"><strong><%= t("Pickup code") %></strong><code class="pickup-code"><%= reservation.pickupCode %></code></p>
  <p class="pickup-fact"><strong><%= t("Location:") %></strong> <%= reservation.food.pickupLocation %></p>
  <p class="pickup-fact"><strong><%= t("Instructions:") %></strong> <%= reservation.food.pickupInstructions %></p>
  <% if (reservation.status === 'collected') { %>
    <p class="reservation-note"><%= t("Collection confirmed. Collected reservations cannot be cancelled.") %></p>
  <% } else if (reservation.canCancel) { %>
    <form method="post" action="/reservations/<%= reservation.id %>/cancel" class="cancel-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="button button-secondary"><%= t("Cancel reservation") %></button>
    </form>
    <p class="field-help"><%= t("Cancellation is available until the pickup window ends.") %></p>
  <% } else { %>
    <p class="reservation-note"><%= t("The pickup deadline has passed. Cancellation is no longer available.") %></p>
  <% } %>
  <% } %>
</article>
