<% const t = typeof locals.t === 'function' ? locals.t : value => String(value ?? ''); const lang = locals.lang || 'en'; %>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#173f35">
  <meta name="description" content="Community Table is a student food-sharing app for sharing food and reserving pickups.">
  <title><%= t(title) %> <%= t("· Community Table") %></title>
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
  <link rel="stylesheet" href="/css/styles.css">
  <script src="/js/app.js" defer></script>
</head>
<body data-required-message="<%= t('Please complete this field.') %>" data-invalid-message="<%= t('Enter a valid value.') %>" data-email-message="<%= t('Enter a valid email address.') %>" data-length-message="<%= t('Check the length of this value.') %>" data-number-message="<%= t('Enter a whole number within the displayed limits.') %>" data-reserving-message="<%= t('Reserving…') %>" data-reserve-message="<%= t('Reserve food') %>" data-quantity-singular-message="<%= t('1 portion selected.') %>" data-quantity-message="<%= t('{count} portions selected.') %>">
  <a class="skip-link" href="#main-content"><%= t("Skip to content") %></a>
  <div class="app-shell">
    <div class="app-content">
    <header class="app-header">
      <a class="brand" href="/" aria-label="<%= t('Community Table home') %>">
        <span class="brand-mark"><%- include('icon', { name: 'table' }) %></span>
        <span><%= t("Community Table") %></span>
      </a>
      <a class="about-link" href="/about"><%= t("About") %></a>
    </header>
    <form class="language-switch" method="post" action="/language">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="returnTo" value="<%= typeof returnTo === 'string' ? returnTo : '/' %>">
      <label for="language"><%= t('Language') %></label>
      <select id="language" name="language"><option value="en" <%= lang === 'en' ? 'selected' : '' %>>English</option><option value="am" <%= lang === 'am' ? 'selected' : '' %>>አማርኛ</option></select>
      <button type="submit"><%= t('Apply') %></button>
    </form>
