<% const t = typeof locals.t === 'function' ? locals.t : value => String(value ?? ''); const lang = locals.lang || 'en'; %>
<%- include('../partials/header') %>
<main id="main-content" class="page">
  <%- include('top') %>
  <% if (notice) { %><p class="preview-notice" role="status"><%= t(notice) %></p><% } %>
  <% if (selected) { %>
    <section class="pickup-card"><h2><%= t("Confirm selected account") %></h2><p class="pickup-fact"><strong><%= t("Name:") %></strong> <%= selected.name %></p><p class="pickup-fact"><strong><%= t("Exact email:") %></strong> <%= selected.email %></p><p class="pickup-fact"><strong><%= t("Action:") %></strong> <%= t(selected.operation === 'add' ? 'Add as volunteer' : 'Remove volunteer access') %> <%= t("for") %> <%= organization.name %>.</p>
    <form class="account-form" method="post" action="<%= organizerBase %>/volunteers/confirm"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="selectionToken" value="<%= selected.token %>"><input type="hidden" name="userId" value="<%= selected.userId %>"><label class="confirmation-check"><input type="checkbox" name="confirm" value="yes" required> <%= t("I confirm this is the intended registered account.") %></label><button class="button button-primary" type="submit"><%= t("Confirm") %> <%= t(selected.operation === 'add' ? 'add volunteer' : 'remove volunteer') %></button></form>
    <a class="text-action" href="<%= organizerBase %>/volunteers"><%= t("Cancel and return") %></a></section>
  <% } else { %>
    <form class="account-form" method="post" action="<%= organizerBase %>/volunteers/lookup"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="email"><%= t("Existing organizer account’s exact email") %></label><input id="email" name="email" type="email" maxlength="254" required><label for="operation"><%= t("Action") %></label><select id="operation" name="operation"><option value="add"><%= t("Add volunteer") %></option><option value="remove"><%= t("Remove volunteer") %></option></select><button class="button button-primary" type="submit"><%= t("Find account to confirm") %></button></form>
    <section class="detail-section"><h2><%= t("Invite a new volunteer") %></h2><p><%= t("Create a separate organizer account by invitation. Use a different email from any recipient account. Invitations expire after seven days.") %></p>
      <form class="account-form" method="post" action="<%= organizerBase %>/invitations">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="invite-email"><%= t("New organizer email") %></label><input id="invite-email" name="email" type="email" maxlength="254" required>
        <label class="confirmation-check"><input type="checkbox" name="confirm" value="invite" required> <%= t("I confirm this email is intended for a new volunteer organizer account.") %></label>
        <button class="button button-primary" type="submit"><%= t("Create volunteer invitation") %></button>
      </form>
    </section>
    <section class="detail-section"><h2><%= t("Current volunteers") %></h2><% if (!volunteers.length) { %><p><%= t("No volunteers assigned.") %></p><% } %><div class="pickup-list"><% volunteers.forEach(member => { if (member.user) { %><article class="pickup-card"><h2><%= member.user.name %></h2><p class="organization"><%= member.user.email %></p></article><% } }); %></div></section>
  <% } %>
</main>
<%- include('../partials/footer') %>
