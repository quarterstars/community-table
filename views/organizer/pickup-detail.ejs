<% const t = typeof locals.t === 'function' ? locals.t : value => String(value ?? ''); const lang = locals.lang || 'en'; %>
<%- include('../partials/header') %>
<main id="main-content" class="page">
  <% if (locals.personal) { %><a class="back-link" href="/share-food"><%= t('Share Food') %></a><div class="page-intro"><h1><%= t(title) %></h1></div><% } else { %><%- include('top') %><% } %>
  <section class="pickup-card"><h2><%= reservation.food.name %></h2><p class="pickup-fact"><strong><%= t("Recipient:") %></strong> <%= t(reservation.user?.name || 'Account unavailable') %></p><p class="organization"><%= reservation.user?.email || '' %></p><p class="pickup-fact"><strong><%= t("Quantity:") %></strong> <%= reservation.quantity %> <%= t("portions") %></p><p class="pickup-fact"><strong><%= t("Pickup:") %></strong> <%= reservation.pickupDate %><span class="pickup-window"><%= reservation.pickupWindow %> <%= t("· America/Chicago") %></span></p><p class="pickup-fact"><strong><%= t("Code:") %></strong><code class="pickup-code"><%= reservation.pickupCode %></code></p><p class="pickup-fact"><strong><%= t("Status:") %></strong> <%= t(reservation.displayStatus) %></p><p class="pickup-fact"><strong><%= t("Location:") %></strong> <%= reservation.food.pickupLocation %></p><p class="pickup-fact"><strong><%= t("Instructions:") %></strong> <%= reservation.food.pickupInstructions %></p>
    <% if (canCollect) { %><form class="account-form" method="post" action="<%= organizerBase %>/pickups/<%= reservation.id %>/confirm"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="confirmation-check"><input type="checkbox" name="confirm" value="collected" required> <%= t("I confirm the recipient has collected these portions.") %></label><button class="button button-primary" type="submit"><%= t("Confirm collection") %></button></form><% } else { %><p class="reservation-note"><%= t("Collection is unavailable: the window has not started, has ended, or the reservation was cancelled or already collected.") %></p><% } %>
  </section>
</main>
<%- include('../partials/footer') %>
