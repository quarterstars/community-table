# Copy to .env. Never commit real credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/community_table?replicaSet=rs0
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Set to 1 only behind exactly one trusted reverse proxy; production requires HTTPS.
TRUST_PROXY=0
# Optional: dedicated MongoDB replica-set server for tests. Tests use a unique database.
# Otherwise npm test starts an isolated temporary MongoDB replica set automatically.
TEST_MONGODB_URI=
